{
  "manifest_version": 3,
  "name": "Preço Perto — conexão MPBR (experimental)",
  "version": "0.1.0",
  "minimum_chrome_version": "118",
  "description": "Auxilia o retorno do login MPBR iniciado no Preço Perto, com autorização do usuário.",
  "permissions": ["debugger", "storage", "alarms"],
  "host_permissions": ["https://menopreco-1.onrender.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [{
    "matches": ["https://menopreco-1.onrender.com/*"],
    "js": ["bridge.js"],
    "run_at": "document_start"
  }]
}
